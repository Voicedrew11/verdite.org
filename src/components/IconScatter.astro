---
// Port icons scattered over the screen, each dropping in once on load and
// settling. One per cell of a 4 x 4 grid, nudged randomly within its cell, so
// they cover the screen evenly without looking lined up. Positions come from
// a generator seeded by `seed`, so the same seed gives the same layout on
// every visit and different seeds give different layouts.
//
// With several ports, each appears equally often in a shuffled order. A port
// with a backdrop shows that picture instead of its icon, turned any way,
// sometimes mirrored, and rim-lit with its backdrop glow.
//
// Positioning is up to the caller's class (.game-ambience on port pages,
// .intro-icons on the intro).
import PortIcon from "./PortIcon.astro";
import type { Game } from "../data/games";

interface Props {
  ports: Game[];
  seed: string;
  class: string;
}
const { ports, seed, class: className } = Astro.props;

const GRID = 4;
const CELL_PCT = 100 / GRID;
const random = seededRandom(seed);

// Every port equally often, shuffled.
const cells = GRID * GRID;
const order = Array.from({ length: cells }, (_, i) => ports[i % ports.length]!);
for (let i = order.length - 1; i > 0; i--) {
  const j = Math.floor(random() * (i + 1));
  [order[i], order[j]] = [order[j]!, order[i]!];
}

const items = order.map((port, i) => {
  const col = i % GRID;
  const row = Math.floor(i / GRID);
  const jitter = () => (random() - 0.5) * CELL_PCT * 0.6;
  const tilt_max_deg = port.backdrop ? 180 : 25;
  const size_min_px = port.backdrop ? 44 : 28;
  return {
    port,
    left_pct: Math.round(col * CELL_PCT + CELL_PCT / 2 + jitter() - 2),
    rest_pct: Math.round(row * CELL_PCT + CELL_PCT / 2 + jitter() - 3),
    delay_ms: Math.round(random() * 900),
    size_px: size_min_px + Math.round(random() * 30),
    tilt_deg: Math.round((random() * 2 - 1) * tilt_max_deg),
    mirror: port.backdrop && random() < 0.5 ? -1 : 1,
  };
});

function seededRandom(text: string): () => number {
  let h = 2166136261;
  for (const ch of text) h = Math.imul(h ^ ch.charCodeAt(0), 16777619);
  return () => {
    h = Math.imul(h ^ (h >>> 15), 2246822507);
    h = Math.imul(h ^ (h >>> 13), 3266489909);
    h ^= h >>> 16;
    return (h >>> 0) / 4294967296;
  };
}

function placement(item: (typeof items)[number]): string {
  return `--x:${item.left_pct}%;--y:${item.rest_pct}%;--delay:${item.delay_ms}ms;` +
    `--size:${item.size_px}px;--tilt:${item.tilt_deg}deg;--mirror:${item.mirror};`;
}
---
<div class:list={["icon-scatter", className]} aria-hidden="true">
  {items.map((item) => (
    item.port.backdrop
      ? <img
          class="scatter-backdrop"
          src={item.port.backdrop.image.src}
          alt=""
          decoding="async"
          style={`${placement(item)}--glow:${item.port.backdrop.glow};`}
        />
      : <PortIcon game={item.port} size_px={item.size_px} style={placement(item)} />
  ))}
</div>
