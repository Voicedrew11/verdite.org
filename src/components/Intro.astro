---
// The front-page intro: the verdite slides across the screen, uncovering the
// Verdite Project logo behind it, then the logo moves up into the nav bar as
// the site fades in. Plays once per browser tab session. Skipped with reduced
// motion, and never shown without JavaScript (the overlay only displays while
// <html data-intro> is set).
import { Image } from "astro:assets";
import logo from "../assets/verdite-project.webp";
---
<script is:inline>
  (function () {
    try {
      if (sessionStorage.getItem("verdite-intro-seen")) return;
    } catch (e) { /* storage blocked: play it */ }
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    document.documentElement.dataset.intro = "play";
  })();
</script>

<div class="intro" id="intro">
  <div class="intro-backdrop"></div>
  <div class="intro-logo">
    <Image src={logo} alt="" widths={[734, 1467]} sizes="min(80vw, 46rem)" loading="eager" />
  </div>
  <canvas class="intro-verdite" aria-hidden="true"></canvas>
  <button class="intro-skip" type="button">Skip intro</button>
</div>

<script>
  import { playIntro } from "../scripts/intro";

  const overlay = document.getElementById("intro");
  if (overlay && document.documentElement.dataset.intro === "play") {
    playIntro(overlay);
  }
</script>

<style>
  .intro {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    place-items: center;
    cursor: pointer;
  }
  :global(html[data-intro]) .intro { display: grid; }
  :global(html[data-intro]) body { overflow: hidden; }
  /* The nav's own logo stays hidden until the intro's copy lands on it. */
  :global(html[data-intro] .nav-logo img) { visibility: hidden; }

  .intro-backdrop {
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 50% at 50% 50%, #0f1d14 0%, var(--bg) 100%) var(--bg);
  }

  .intro-logo {
    grid-area: 1 / 1;
    position: relative;
    width: min(80vw, 46rem);
    transform-origin: 0 0;
    /* intro.ts moves the right edge of this clip along with the verdite. */
    --hidden-right: 100%;
    clip-path: inset(-50% var(--hidden-right) -50% -50%);
  }
  .intro-logo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .intro-verdite {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .intro-skip {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    color: var(--muted);
    font: 500 0.8rem var(--sans);
    cursor: pointer;
  }
  .intro-skip:hover, .intro-skip:focus-visible { color: var(--text); }
</style>
