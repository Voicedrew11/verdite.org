---
import "@fontsource-variable/inter";
import "@fontsource-variable/saira/wdth.css";
import "../styles/site.css";
import { Image } from "astro:assets";
import logo from "../assets/verdite-project.webp";
import { site, tabs, type Tab } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}
const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · Verdite Project` : "Verdite Project · King’s Field, native on your computer";

const path = Astro.url.pathname;
function isCurrent(tab: Tab): boolean {
  if (tab.href === "/") return path === "/";
  return path.startsWith(tab.href.replace(/\/$/, ""));
}
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en-us">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="color-scheme" content="dark" />
<meta name="theme-color" content="#07090a" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
<slot name="before-page" />
<header class="nav">
  <div class="nav-inner">
    <a class="nav-logo" href="/" aria-label="Verdite Project, home">
      <Image src={logo} alt="Verdite Project" widths={[180, 360]} sizes="9rem" loading="eager" />
    </a>
    <nav class="nav-links" aria-label="Main">
      {tabs.filter((tab) => tab.href !== "/").map((tab) => (
        <a href={tab.href} aria-current={isCurrent(tab) ? "page" : undefined}>{tab.name}</a>
      ))}
    </nav>
    <a class="btn btn-primary btn-small nav-cta" href="/downloads/">Download</a>
  </div>
</header>
<main>
<slot />
</main>
<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <Image src={logo} alt="Verdite Project" widths={[140, 280]} sizes="7rem" />
      <p>Native ports of King’s Field. Not affiliated with FromSoftware.<br />Bring your own disc; this site will never host game data.</p>
    </div>
    <nav class="footer-links" aria-label="Elsewhere">
      <a href={site.discord}>Discord</a>
      <a href={site.github}>GitHub</a>
      <a href={site.wiki}>Wiki</a>
    </nav>
  </div>
  <p class="container footer-fine">© {year} Verdite Project</p>
</footer>
</body>
</html>
