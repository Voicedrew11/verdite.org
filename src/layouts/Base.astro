---
import "@fontsource-variable/inter";
import "@fontsource-variable/saira/wdth.css";
import "../styles/site.css";
import { Image } from "astro:assets";
import DownloadIcon from "../components/DownloadIcon.astro";
import logo from "../assets/verdite-project.webp";
import { site, tabs, type Tab } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  /** A port's theme name (src/styles/themes/<theme>.css), set on <body>. */
  theme?: string;
}
const { title, description = site.description, theme } = Astro.props;
const pageTitle = title ? `${title} · Verdite Project` : "Verdite Project";

const path = Astro.url.pathname;
function isCurrent(tab: Tab): boolean {
  if (tab.href === "/") return path === "/";
  return path.startsWith(tab.href.replace(/\/$/, ""));
}
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en-us">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="color-scheme" content="dark" />
<meta name="theme-color" content="#07090a" />
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
<link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
</head>
<body data-theme={theme}>
<slot name="before-page" />
<header class="nav">
  <div class="nav-inner">
    <a class="nav-logo" href="/" aria-label="Verdite Project, home">
      <Image src={logo} alt="Verdite Project" widths={[180, 360]} sizes="9rem" loading="eager" />
    </a>
    <nav class="nav-links" aria-label="Main">
      {tabs.filter((tab) => tab.inNav).map((tab) => (
        <a href={tab.href} aria-current={isCurrent(tab) ? "page" : undefined}>{tab.name}</a>
      ))}
    </nav>
    <a class="btn btn-primary btn-small nav-cta" href="/downloads/" aria-current={path.startsWith("/downloads") ? "page" : undefined}><DownloadIcon size={16} />Download</a>
  </div>
</header>
<main>
<slot />
</main>
<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <Image src={logo} alt="Verdite Project" widths={[140, 280]} sizes="7rem" />
      <p>Native ports of classic games, rebuilt from the original code.<br />Not affiliated with FromSoftware or any publisher. Bring your own copy;<br />this site will never host game data.</p>
    </div>
    <div class="footer-columns">
      <nav class="footer-links" aria-label="Quick links">
        <h2>Quick links</h2>
        <a href="/">Home</a>
        <a href="/downloads/">Downloads</a>
        {tabs.filter((tab) => tab.inNav && tab.href.startsWith("/")).map((tab) => <a href={tab.href}>{tab.name}</a>)}
      </nav>
      <nav class="footer-links" aria-label="Connect">
        <h2>Connect</h2>
        <a href={site.discord}>Discord</a>
        <a href={site.github}>GitHub</a>
        <a href={site.wiki}>Wiki</a>
      </nav>
    </div>
  </div>
  <p class="container footer-fine">© {year} Verdite Project</p>
</footer>
</body>
</html>
