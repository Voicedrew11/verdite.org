---
// Downloads: what the ports are, which copy you need, then the live port
// cards. Each card leads to the port's own page with every file and version.
import Base from "../layouts/Base.astro";
import PortsSection from "../components/PortsSection.astro";
import { site } from "../data/site";
---
<Base title="Downloads" description="Download the latest release of each Verdite port for Windows, macOS, Linux, Android, and iOS.">
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Get started</p>
      <h1>Downloads</h1>
      <p class="lede">Native ports of classic games. Free, and rebuilt to run on the hardware you have.</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="callout">
        <div>
          <h3>Which copy do you need?</h3>
          <p>Each port needs your own disc image of one specific release, named on its card.</p>
        </div>
        <a class="btn btn-ghost" href="/guides/">Read the guides</a>
      </div>
    </div>
  </section>

  <PortsSection />

  <section class="section-tight">
    <div class="container">
      <div class="callout">
        <div>
          <h3>Need help?</h3>
          <p>The wiki covers setup and troubleshooting.</p>
        </div>
        <div class="actions">
          <a class="btn btn-ghost" href={site.wiki}>Visit the wiki</a>
          <a class="btn btn-ghost" href={site.discord}>Ask on Discord</a>
        </div>
      </div>
    </div>
  </section>
</Base>
