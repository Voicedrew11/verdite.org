---
// One page per port: what it is, the latest release with a file for each
// system, every older version, and the other ports.
// A port with a `theme` in src/data/games.ts gets its own look from
// src/styles/themes/<theme>.css, scoped to body[data-theme="<theme>"].
import PortIcon from "../../components/PortIcon.astro";
import Base from "../../layouts/Base.astro";
import GitHubSnapshot from "../../components/GitHubSnapshot.astro";
import { games, gameSlug, gamePath, type Game } from "../../data/games";

// Every theme file is bundled with this page; each only applies to its port.
import.meta.glob("../../styles/themes/*.css", { eager: true });

export function getStaticPaths() {
  return games.map((game) => ({ params: { slug: gameSlug(game) }, props: { game } }));
}

interface Props {
  game: Game;
}
const { game } = Astro.props;
const others = games.filter((g) => g !== game);

// The port's icon drops in once on load and settles behind the page;
// shown only when the port's theme turns it on (.game-ambience { display: block; }).
// Positions come from a generator seeded by the port's name, so each port
// has its own layout and it stays the same on every visit.
function seededRandom(seed: string): () => number {
  let h = 2166136261;
  for (const ch of seed) h = Math.imul(h ^ ch.charCodeAt(0), 16777619);
  return () => {
    h = Math.imul(h ^ (h >>> 15), 2246822507);
    h = Math.imul(h ^ (h >>> 13), 3266489909);
    h ^= h >>> 16;
    return (h >>> 0) / 4294967296;
  };
}
const random = seededRandom(game.name);

// One icon per cell of a 4 x 4 grid over the screen, nudged randomly within
// its cell, so they cover the screen evenly without looking lined up.
const GRID = 4;
const CELL_PCT = 100 / GRID;
const falling = Array.from({ length: GRID * GRID }, (_, i) => {
  const col = i % GRID;
  const row = Math.floor(i / GRID);
  const jitter = () => (random() - 0.5) * CELL_PCT * 0.6;
  return {
    left_pct: Math.round(col * CELL_PCT + CELL_PCT / 2 + jitter() - 2),
    rest_pct: Math.round(row * CELL_PCT + CELL_PCT / 2 + jitter() - 3),
    delay_ms: Math.round(random() * 900),
    size_px: 28 + Math.round(random() * 30),
    tilt_deg: Math.round(random() * 50) - 25,
  };
});
---
<Base title={game.name} description={`${game.summary} Download the latest release.`} theme={game.theme}>
  <div class="game-ambience" aria-hidden="true">
    {falling.map((f) => (
      <PortIcon game={game} size_px={f.size_px} style={`--x:${f.left_pct}%;--y:${f.rest_pct}%;--delay:${f.delay_ms}ms;--size:${f.size_px}px;--tilt:${f.tilt_deg}deg`} />
    ))}
  </div>
  <section class="game-hero">
    <div class="container game-hero-inner">
      <a class="back-link" href="/downloads/">← All ports</a>
      <div class="game-icon-frame">
        <PortIcon class="game-icon" game={game} size_px={128} />
      </div>
      <h1 class="game-name">{game.name}</h1>
      <p class="game-subtitle">{game.game}</p>
      <p class="game-edition">{game.edition}</p>
      <p class="lede">{game.summary}</p>
      <p class="notice">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 8v5" /><path d="M12 16.5v.5" /></svg>
        <span><strong>You need your own copy.</strong> This port needs a disc image of <code>{game.needs}</code>. We don’t include or host game data.</span>
      </p>
    </div>
  </section>
  <div class="game-divider" aria-hidden="true"></div>

  <GitHubSnapshot />
  <section class="section-tight">
    <div class="container" data-repo={game.repo}>
      <h2 class="game-section-title">Latest release</h2>
      <article class="download">
        <header class="download-head">
          <div>
            <h3 class="release-tag" data-latest-tag>Checking GitHub…</h3>
          </div>
          <span class="pill" data-latest-meta></span>
        </header>
        <div class="download-primary" data-primary></div>
        <ul class="file-list" data-files></ul>
        <p class="download-links">
          <a href={`https://github.com/${game.repo}/releases/latest`} data-latest-page>Release notes on GitHub</a>
          <a href={`https://github.com/${game.repo}`}>Source</a>
        </p>
      </article>

      <h2 class="game-section-title">Older versions</h2>
      <div class="version-list" data-older>
        <p class="muted-text" data-older-empty>Older versions appear here once GitHub answers.</p>
      </div>
    </div>
  </section>

  <div class="game-divider" aria-hidden="true"></div>
  <section class="section game-others">
    <div class="container">
      <h2 class="game-section-title">Other ports</h2>
      <ul class="other-ports">
        {others.map((g) => (
          <li>
            <a class="port-link port-card" href={gamePath(g)}>
              <PortIcon class="port-icon" game={g} size_px={64} />
              <span class="port-name">{g.name}</span>
              <span class="port-game">{g.game}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<script>
  import {
    releases, visitorOs, fileFor, formatDate, formatMegabytes, formatCount,
    type Release, type ReleaseFile,
  } from "../../scripts/releases";

  const os = visitorOs();

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, className: string, text = ""): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    node.className = className;
    node.textContent = text;
    return node;
  }

  function fileLink(file: ReleaseFile, className: string): HTMLAnchorElement {
    const a = el("a", className);
    a.href = file.url;
    a.append(el("span", "", file.kind.label), el("span", "file-size", formatMegabytes(file.bytes)));
    return a;
  }

  function fileList(files: ReleaseFile[]): HTMLUListElement {
    const list = el("ul", "file-list");
    for (const file of files) {
      const li = document.createElement("li");
      li.append(fileLink(file, "file"));
      list.append(li);
    }
    return list;
  }

  function renderLatest(root: HTMLElement, latest: Release): void {
    root.querySelector("[data-latest-tag]")!.textContent = latest.tag;
    root.querySelector("[data-latest-meta]")!.textContent =
      `${formatDate(latest.published)} · ${formatCount(latest.downloads)} downloads`;
    root.querySelector<HTMLAnchorElement>("[data-latest-page]")!.href = latest.page;

    const primary = fileFor(latest, os);
    if (primary) {
      const link = fileLink(primary, "btn btn-primary btn-large");
      link.prepend(el("span", "btn-kicker", "Recommended"));
      root.querySelector("[data-primary]")!.append(link);
    }
    root.querySelector("[data-files]")!.replaceWith(fileList(latest.files.filter((f) => f !== primary)));
  }

  // Each older version is a closed row that opens to show its files.
  function renderOlder(root: HTMLElement, older: Release[]): void {
    const box = root.querySelector("[data-older]")!;
    box.replaceChildren();
    if (older.length === 0) {
      box.append(el("p", "muted-text", "No older versions yet."));
      return;
    }
    for (const release of older) {
      const row = el("details", "version");
      const summary = el("summary", "version-summary");
      summary.append(
        el("span", "version-tag", release.tag),
        el("span", "version-date", formatDate(release.published)),
        el("span", "version-downloads", `${formatCount(release.downloads)} downloads`),
      );
      const notes = el("a", "version-notes", "Release notes on GitHub");
      notes.href = release.page;
      row.append(summary, fileList(release.files), notes);
      box.append(row);
    }
  }

  const root = document.querySelector<HTMLElement>("[data-repo]");
  if (root) {
    releases(root.dataset.repo ?? "")
      .then((list) => {
        const [latest, ...older] = list;
        if (!latest) {
          root.querySelector("[data-latest-tag]")!.textContent = "No release yet";
          renderOlder(root, []);
          return;
        }
        renderLatest(root, latest);
        renderOlder(root, older);
      })
      .catch(() => {
        root.querySelector("[data-latest-tag]")!.textContent = "Couldn’t reach GitHub";
        root.querySelector("[data-older-empty]")!.textContent = "Use the release notes link above to see every version.";
      });
  }
</script>
